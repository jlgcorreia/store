# syntax=docker/dockerfile:1.7

FROM node:20-alpine AS base

WORKDIR /app

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
FROM base AS deps

COPY package.json ./

RUN --mount=type=cache,id=yarn-cache,target=/root/.yarn/berry/cache \
    yarn install --immutable


# ─────────────────────────────────────────────
# Build
# ─────────────────────────────────────────────
FROM base AS builder

COPY package.json ./

COPY --from=deps /app/node_modules ./node_modules

# Source comes after dependencies so source changes don't
# invalidate the dependency installation.
COPY . .
RUN yarn build


# ─────────────────────────────────────────────
# Production dependencies
# ─────────────────────────────────────────────
FROM node:20-alpine AS production-deps

WORKDIR /app

# Copy only the generated production server package manifest first.
COPY --from=builder /app/.medusa/server/package*.json ./

RUN --mount=type=cache,id=yarn-cache,target=/root/.yarn/berry/cache \
    yarn install --immutable --mode=skip-builds


# ─────────────────────────────────────────────
# Production
# ─────────────────────────────────────────────
FROM node:20-alpine AS runner

ENV NODE_ENV=production

WORKDIR /app

# Generated Medusa server
COPY --from=builder /app/.medusa/server ./

# Production node_modules installed separately
COPY --from=production-deps /app/node_modules ./node_modules

EXPOSE 9000

CMD ["yarn", "start"]