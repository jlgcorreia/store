# syntax=docker/dockerfile:1.7

FROM node:20-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable \
    && corepack prepare pnpm@10.11.1 --activate

WORKDIR /app


# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install \
        --frozen-lockfile \
        --filter @dtc/backend...


# ─────────────────────────────────────────────
# Build
# ─────────────────────────────────────────────
FROM base AS builder

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/package.json

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/backend/node_modules ./apps/backend/node_modules

# Source comes after dependencies so source changes don't
# invalidate the dependency installation.
COPY apps/backend ./apps/backend

RUN pnpm --filter @dtc/backend build


# ─────────────────────────────────────────────
# Production dependencies
# ─────────────────────────────────────────────
FROM node:20-alpine AS production-deps

WORKDIR /app

# Copy only the generated production server package manifest first.
COPY --from=builder /app/apps/backend/.medusa/server/package*.json ./

RUN --mount=type=cache,id=npm-cache,target=/root/.npm \
    npm install --omit=dev


# ─────────────────────────────────────────────
# Production
# ─────────────────────────────────────────────
FROM node:20-alpine AS runner

ENV NODE_ENV=production

WORKDIR /app

# Generated Medusa server
COPY --from=builder /app/apps/backend/.medusa/server ./

# Production node_modules installed separately
COPY --from=production-deps /app/node_modules ./node_modules

EXPOSE 9000

CMD ["npm", "start"]